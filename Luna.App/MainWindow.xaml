<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Luna.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Luna.App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <local:LoginView x:Name="LoginPane" />
        <local:HomeView x:Name="HomePane" Visibility="Collapsed" />
    </Grid>
</Window>
