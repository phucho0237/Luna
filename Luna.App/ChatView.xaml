<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Luna.App.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Luna.App"
    Loaded="OnViewLoaded"
    Unloaded="OnViewUnloaded">

    <UserControl.Resources>
        <!-- The user's own messages: right side, a neutral filled bubble. Bubbles take at most 7 of 10 star units of the row. -->
        <DataTemplate x:Key="SelfMessageTemplate" x:DataType="local:MessageRow">
            <Grid Padding="0,2,0,2" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="7*" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Padding="12,8,12,6"
                    CornerRadius="8"
                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind PlainText}"
                            Visibility="{x:Bind PlainVisibility}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{x:Bind KindText}"
                            Visibility="{x:Bind KindVisibility}"
                            FontStyle="Italic"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind TimeText}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Other people's messages: left side, a card bubble, with the sender label above in a group. -->
        <DataTemplate x:Key="OtherMessageTemplate" x:DataType="local:MessageRow">
            <Grid Padding="0,2,0,2" AutomationProperties.Name="{x:Bind AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Border
                    HorizontalAlignment="Left"
                    Padding="12,8,12,6"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Text="{x:Bind SenderLabel}"
                            Visibility="{x:Bind SenderVisibility}"
                            FontWeight="SemiBold"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{x:Bind PlainText}"
                            Visibility="{x:Bind PlainVisibility}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            Text="{x:Bind KindText}"
                            Visibility="{x:Bind KindVisibility}"
                            FontStyle="Italic"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="{x:Bind TimeText}"
                            HorizontalAlignment="Right"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <local:MessageTemplateSelector
            x:Key="MessageSelector"
            SelfTemplate="{StaticResource SelfMessageTemplate}"
            OtherTemplate="{StaticResource OtherMessageTemplate}" />
    </UserControl.Resources>

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: the conversation title (the same title logic as the list) and a short note. -->
        <StackPanel x:Name="Header" x:Uid="ChatHeader" Grid.Row="0" Padding="0,0,0,4">
            <TextBlock
                x:Name="TitleText"
                FontSize="20"
                FontWeight="SemiBold"
                MaxLines="1"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock
                x:Name="SubtitleText"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <ListView
                x:Name="MessageList"
                x:Uid="ChatMessageList"
                SelectionMode="None"
                IsItemClickEnabled="False"
                ItemTemplateSelector="{StaticResource MessageSelector}"
                SizeChanged="OnListSizeChanged">
                <!-- Only the end-of-history line lives in the list (it appears once, when the oldest stored message is shown).
                     The loading indicator is the overlay chip below, so it never moves the content. -->
                <ListView.Header>
                    <TextBlock
                        x:Name="StartText"
                        Margin="0,12,0,12"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </ListView.Header>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- The view sets the mode before every change it mirrors; this is only the safe default. -->
                        <ItemsStackPanel ItemsUpdatingScrollMode="KeepItemsInView" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="0" />
                        <!-- Left 0 as before; right 20 so a right-aligned bubble never sits under the overlay scrollbar. The
                             bubbles size to their content (star columns, no fixed width) and the text wraps. -->
                        <Setter Property="Padding" Value="0,0,20,0" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Overlay chip while an older page is read: it floats over the list, takes no space and no clicks. -->
            <Border
                x:Name="LoadingChip"
                Margin="0,8,0,0"
                Padding="12,6,12,6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                CornerRadius="16"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        x:Name="LoadingRing"
                        x:Uid="ChatLoadingOlderRing"
                        Width="16"
                        Height="16"
                        IsActive="False" />
                    <TextBlock
                        x:Name="LoadingText"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <TextBlock
                x:Name="StateText"
                Margin="0,16,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                AutomationProperties.LiveSetting="Polite"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
