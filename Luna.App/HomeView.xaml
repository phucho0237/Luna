<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Luna.App.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Luna.App">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <!-- Wide: both columns, nothing changes. -->
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="700" />
                    </VisualState.StateTriggers>
                </VisualState>
                <!-- Narrow: the right column goes away and the left column takes the whole width. -->
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftColumn.Width" Value="*" />
                        <Setter Target="RightColumn.MinWidth" Value="0" />
                        <Setter Target="RightColumn.Width" Value="0" />
                        <Setter Target="RightPane.Visibility" Value="Collapsed" />
                        <Setter Target="Divider.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- The two-column page. Hidden while there is no home view model. -->
        <Grid x:Name="Columns">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="340" />
                <ColumnDefinition x:Name="RightColumn" Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left column: status, buttons and the conversation list. -->
            <Grid Grid.Column="0" Padding="16,16,8,0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    x:Uid="HomeBrand"
                    FontSize="28"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                <!-- Connection: a small status dot (one of four, chosen in code) and the connection text. -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        x:Uid="HomeConnectionDot"
                        Width="10"
                        Height="10"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw">
                        <Ellipse x:Name="DotConnected" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />
                        <Ellipse x:Name="DotBusy" Fill="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                        <Ellipse x:Name="DotDown" Fill="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                        <Ellipse x:Name="DotIdle" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                    </Grid>
                    <TextBlock
                        x:Name="ConnectionText"
                        Grid.Column="1"
                        AutomationProperties.LiveSetting="Polite"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />
                </Grid>

                <TextBlock
                    x:Name="FriendsText"
                    Grid.Row="2"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="RefreshButton"
                        x:Uid="HomeRefreshButton"
                        TabIndex="0" />
                    <Button
                        x:Name="ReconnectButton"
                        x:Uid="HomeReconnectButton"
                        TabIndex="1"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Row="4" Spacing="8">
                    <InfoBar
                        x:Name="SaveProblemBar"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Warning" />
                    <InfoBar
                        x:Name="ListErrorBar"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Error" />
                </StackPanel>

                <Grid Grid.Row="5">
                    <ListView
                        x:Name="ConversationList"
                        x:Uid="HomeConversationList"
                        TabIndex="2"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ConversationRow">
                                <StackPanel Padding="0,8,0,8" AutomationProperties.Name="{x:Bind AutomationName}">
                                    <TextBlock
                                        Text="{x:Bind Title}"
                                        MaxLines="1"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                    <TextBlock
                                        Text="{x:Bind TimeText}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyText"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Visibility="Collapsed" />
                </Grid>
            </Grid>

            <Border
                x:Name="Divider"
                Grid.Column="0"
                HorizontalAlignment="Right"
                Width="1"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Right column: only a placeholder until the chat pane (T7c). -->
            <Grid x:Name="RightPane" Grid.Column="1" Padding="24">
                <TextBlock
                    x:Uid="HomePlaceholder"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </Grid>
        </Grid>

        <!-- Shown instead of the columns when there is no home view model. -->
        <TextBlock
            x:Name="UnavailableText"
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AutomationProperties.LiveSetting="Polite"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            TextAlignment="Center"
            Visibility="Collapsed" />
    </Grid>
</UserControl>
